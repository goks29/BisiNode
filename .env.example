# .env.example — Copy file ini menjadi .env dan isi nilainya
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DB_NAME
LOG_LEVEL=3

# ML Model Configuration
MODEL_ABJAD_PATH=assets/models/abjad_v2.tflite
LABEL_ABJAD_PATH=assets/models/labels_abjad.txt
MODEL_ANGKA_PATH=assets/models/angka_v2_fix.tflite
LABEL_ANGKA_PATH=assets/models/labels_angka.txt
CONFIDENCE_THRESHOLD=0.75
INPUT_RESOLUTION=640

# ROI Filter: area atas frame yang diabaikan (cegah deteksi wajah)
ROI_TOP_CUTOFF=0.40